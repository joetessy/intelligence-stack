<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.intelligence-stack.provision-webui</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/yusuf/Projects/intelligence-stack/provision-webui.sh</string>
    </array>

    <!-- Run at login, then re-run only on non-zero exit (e.g. Open WebUI
         wasn't ready in time). Once provisioning succeeds, launchd stops. -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Wait 60s between retries so we don't spin tightly while Docker boots. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/yusuf/Library/Logs/intelligence-stack/provision-webui.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/yusuf/Library/Logs/intelligence-stack/provision-webui.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/yusuf</string>
    </dict>
</dict>
</plist>
